{
    "name": "chronodb",
    "version": "1.0.0",
    "description": "ChronoDB: Local-first TypeScript database with snapshots and optional cloud sync (cloud sync not fully implemented yet)",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "bin": {
        "chronodb": "./dist/cli.js"
    },
    "scripts": {
        "build": "tsc -b",
        "prepare": "npm run build",
        "start": "node dist/cli.js",
        "test": "echo \"No tests defined\" && exit 0"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "keywords": [
        "database",
        "typescript",
        "json",
        "local-first",
        "snapshot",
        "offline",
        "chronodb"
    ],
    "author": "Ayotech <https://github.com/Haryomidey>",
    "license": "MIT",
    "dependencies": {
        "axios": "^1.6.8",
        "conf": "^15.0.2",
        "crypto-js": "^4.2.0",
        "open": "^9.1.0",
        "uuid": "^11.1.0"
    },
    "devDependencies": {
        "@types/crypto-js": "^4.2.2",
        "@types/node": "^24.0.0",
        "typescript": "^5.8.0"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}